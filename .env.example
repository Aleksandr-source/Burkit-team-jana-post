# Local prototype; no Firebase or external AI API keys are required.
PORT=3000
HOST=127.0.0.1
# ASAR_DATA_DIR=/absolute/path/to/persistent-data
# Set to true only behind HTTPS.
COOKIE_SECURE=false
# Optional first-run demo password. Otherwise generated into .data/demo-accounts.txt.
# DEMO_PASSWORD=
# Local model configuration is described in README.md.
JANAMEN_RESOURCE_PROFILE=auto
# auto: <=8 GB RAM uses one CPU thread and a smaller context.
# off: no local model; the HR app and labelled knowledge search remain available.
# ASAR_AI_THREADS=1
# ASAR_AI_MIN_AVAILABLE_MB=2048

# Internal prototype adapters only: mock (default) or off. No vendor calls.
JANAMEN_INTEGRATIONS_MODE=mock
